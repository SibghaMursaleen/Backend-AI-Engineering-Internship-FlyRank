# Configuration for the AI Job Title Normalizer

# API Server settings
PORT=8000
HOST=127.0.0.1

# LLM Switches
LLM_ENABLED=true
LLM_STUB=1

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT=30.0

# Logging
LOG_LEVEL=INFO
