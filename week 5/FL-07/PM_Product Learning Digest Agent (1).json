    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction cleanUrl(value) {\n  if (!value) return '';\n\n  const text = String(value).trim();\n\n  // Markdown link: [text](URL)\n  const markdownMatch = text.match(/\\]\\(\\s*(https?:\\/\\/[^)\\s]+)\\s*\\)/);\n\n  if (markdownMatch) {\n    return markdownMatch[1].trim();\n  }\n\n  return text;\n}\n\n// Find the item containing the existing reading list\nconst readingListItem = items.find(item =>\n  item.json.readingList !== undefined\n);\n\nconst readingList = String(\n  readingListItem?.json.readingList || ''\n);\n\n// Extract every URL already present in reading-list.md\nconst seenLinks = new Set();\n\nconst urlMatches = readingList.match(\n  /https?:\\/\\/[^\\s)\\]]+/g\n) || [];\n\nfor (const url of urlMatches) {\n  seenLinks.add(cleanUrl(url));\n}\n\n// Everything else is an RSS article\nconst articles = items.filter(item =>\n  item.json.readingList === undefined\n);\n\n// Keep only genuinely new articles\nconst newArticles = articles.filter(item => {\n  const url = cleanUrl(item.json.link || item.json.url);\n\n  return url && !seenLinks.has(url);\n});\n\nreturn newArticles;"
      },
