    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst lines = [\n  \"# PM/Product Learning Digest\",\n  \"\",\n];\n\nconst groups = {};\n\nfor (const item of items) {\n  const title = String(item.json.title || \"Untitled\").trim();\n  const skill = String(item.json.skill || \"Other\").trim();\n\n  // Get URL\n  const rawUrl = String(item.json.url || \"\").trim();\n\n  // Extract URL from [text](URL), even if the text contains formatting/newlines\n  const markdownMatch = rawUrl.match(/\\]\\(\\s*(https?:\\/\\/[^\\s)]+)\\s*\\)/);\n  const url = markdownMatch ? markdownMatch[1] : rawUrl;\n\n  // Determine source\n  let source = \"Unknown\";\n\n  if (url.includes(\"productcoalition.com\")) {\n    source = \"Product Coalition\";\n  } else if (url.includes(\"producttalk.org\")) {\n    source = \"Product Talk\";\n  }\n\n  // Get date from any available date field\n  const rawDate =\n    item.json.pubDate ||\n    item.json.publishedAt ||\n    item.json.published ||\n    item.json.date ||\n    \"\";\n\n  let date = \"\";\n\n  if (rawDate) {\n    const parsedDate = new Date(rawDate);\n\n    if (!isNaN(parsedDate.getTime())) {\n      date = parsedDate.toLocaleDateString(\"en-GB\", {\n        day: \"2-digit\",\n        month: \"short\",\n        year: \"numeric\"\n      });\n    } else {\n      date = String(rawDate).trim();\n    }\n  }\n\n  if (!groups[skill]) {\n    groups[skill] = [];\n  }\n\n  groups[skill].push({\n    title,\n    source,\n    date,\n    url\n  });\n}\n\n// Build Markdown\nfor (const skill of Object.keys(groups).sort()) {\n  lines.push(`## ${skill}`);\n  lines.push(\"\");\n\n  for (const article of groups[skill]) {\n    lines.push(`### ${article.title}`);\n    lines.push(\"\");\n    lines.push(`Source: ${article.source}`);\n\n    if (article.date) {\n      lines.push(`Date: ${article.date}`);\n    } else {\n      lines.push(`Date: Not available`);\n    }\n\n    lines.push(`Link: ${article.url}`);\n    lines.push(\"\");\n  }\n}\n\nreturn [\n  {\n    json: {\n      filename: \"reading-list.md\",\n      content: lines.join(\"\\n\")\n    }\n  }\n];"
      },
